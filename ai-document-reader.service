[Unit]
Description=Portable Offline AI Document Reader - REST API Server (sample)
Documentation=file:///home/pi/offline-ai-reader/RASPBERRY_PI_GUIDE.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Change 'pi' to the user that owns the installation if needed
User=sebastian
# WorkingDirectory set to the path observed during install
WorkingDirectory=/home/sebastian/Downloads/Offline-main
Environment="PATH=/home/sebastian/Downloads/Offline-main/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata"

# Prefer the run.sh wrapper (it will use venv if present)
ExecStart=/home/sebastian/Downloads/Offline-main/run.sh

Restart=on-failure
RestartSec=30
StartLimitAction=stop

# Security and isolation (adjust if causing permission issues)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/pi/offline-ai-reader/data /home/pi/offline-ai-reader/logs /home/pi/offline-ai-reader/uploads

# Resource limits
MemoryLimit=512M
CPUQuota=80%
Nice=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-doc-reader

# Timeouts
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

# NOTE: This sample unit has been pre-filled for the path you used during install.
# If you move the project, update `User` and `WorkingDirectory` accordingly.

